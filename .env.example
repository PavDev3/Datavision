# ========================
# DataVision — Variables de entorno
# Copia este archivo como .env y rellena los valores
# NUNCA subas .env al repositorio
# ========================

# Base de datos
DATABASE_URL=postgresql+asyncpg://datavision:datavision@localhost:5432/datavision

# Claude API
ANTHROPIC_API_KEY=

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Motor de visión
VISION_BACKEND_URL=http://localhost:8000
YOLO_MODEL=yolov8m.pt
YOLO_CONFIDENCE=0.5
VISION_DEVICE=cuda   # cuda | cpu
